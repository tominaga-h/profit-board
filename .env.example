# Supabase 接続情報
# ローカル: このファイルを .env にコピーして値を埋める
# 本番: Vercel の Environment Variables に設定する（SPEC 7章）
#
# 各値の入手先は docs/SETUP.md 2章を参照。

# --- アプリが使う（ブラウザに露出してよい） ---
# @nuxtjs/supabase が読む。NUXT_PUBLIC_SUPABASE_* が優先されるが、
# 未設定ならこちらにフォールバックするため、この名前のままでよい。
SUPABASE_URL=
# Anon Key。公開前提であり、保護は RLS が担う。
SUPABASE_KEY=

# --- ローカルの管理作業のみで使う（ブラウザに露出させない） ---
# ★ RLS を完全にバイパスするキー。Vercel の環境変数には設定しないこと。
SUPABASE_SERVICE_ROLE_KEY=
# supabase CLI から DB へ接続する際のパスワード（make db-link / db-push で使用）。
DB_PASSWORD=

# --- サーバ (Nitro API) が使う（ブラウザに露出させない） ---
# Drizzle のランタイム接続文字列。Supavisor transaction mode（port 6543）を使う。
# ダッシュボードの Connect → Transaction pooler の文字列をそのまま貼る。
# パスワードに記号が含まれる場合は URL エンコードする（例: @ → %40）。
# ★ DB パスワードを含むため runtimeConfig.public に置かないこと。Vercel にも設定する。
# 例: postgresql://postgres.<project-ref>:<DB_PASSWORD>@<pooler-host>:6543/postgres
NUXT_DATABASE_URL=

# drizzle-kit pull 専用の接続文字列。Supavisor session mode（port 5432）を使う。
# ダッシュボードの Connect → Session pooler の文字列をそのまま貼る。
# direct 接続（db.<ref>.supabase.co:5432）は IPv6 のみのためコンテナから繋がらないことがある。
# ★ ローカル専用。Vercel には設定しないこと。
# 例: postgresql://postgres.<project-ref>:<DB_PASSWORD>@<pooler-host>:5432/postgres
DIRECT_DATABASE_URL=
